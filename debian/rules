#!/usr/bin/make -f

%:
	dh $@

# The frontend is built with Node before packaging (see README). Fail here
# rather than ship a package that serves an empty page.
override_dh_auto_build:
	test -f midwire_web_ui/static/index.html || \
		{ echo "Build the frontend first: cd frontend && npm ci && npm run build" >&2; exit 1; }

override_dh_install:
	dh_install -X__pycache__ -X.pyc
