# Read by midwire-web-ui.service. Restart the service after changing it.

# Address and port the web UI listens on. 0.0.0.0 means every interface:
# Ethernet, the hotspot and any Wi-Fi network the Pi has joined.
MIDWIRE_WEBUI_HOST=0.0.0.0
MIDWIRE_WEBUI_PORT=80

# HTTPS port. 0 turns HTTPS off. The first start creates a self-signed
# certificate in /var/lib/midwire-web-ui/tls/, which browsers accept after a
# one-time warning. To use your own, replace cert.pem and key.pem there (or
# point these at other files) and delete cert.pem.self-signed.
MIDWIRE_WEBUI_TLS_PORT=443
#MIDWIRE_WEBUI_TLS_CERT=/var/lib/midwire-web-ui/tls/cert.pem
#MIDWIRE_WEBUI_TLS_KEY=/var/lib/midwire-web-ui/tls/key.pem
